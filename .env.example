MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=poker-turnier

# Auth0 (@auth0/nextjs-auth0 v4) - siehe node_modules/@auth0/nextjs-auth0/README.md
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Rolle wird aus dem Auth0-Benutzernamen abgeleitet (admin / tisch1..tisch8),
# siehe lib/authz.js - kein Custom Claim/Action nötig.

# Web Push (VAPID) - Schlüssel erzeugen mit: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
